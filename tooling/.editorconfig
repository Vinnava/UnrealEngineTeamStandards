# Team editorconfig - standard section 3.10. Copy to the project root.
# For editors that do not read .clang-format; the two must agree.
root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.{h,hpp,cpp,inl,cs}]
indent_style = tab
indent_size = 4
tab_width = 4

[*.{uproject,uplugin,json}]
indent_style = tab
indent_size = 4

[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false
