# Team editorconfig - standard section 3.10. Copy to the project root.
# For editors that do not read .clang-format; the two must agree.
root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.{h,hpp,cpp,inl,cs}]
indent_style = tab
indent_size = 4
tab_width = 4

[*.{uproject,uplugin,json}]
indent_style = tab
indent_size = 4

# Unreal config. The editor rewrites these files constantly and does not indent sections, so the rule
# here is only "do not let an editor reformat them" - no trailing-whitespace trimming, which would
# churn every ini the editor touches.
[*.ini]
indent_style = space
indent_size = 4
trim_trailing_whitespace = false
insert_final_newline = false

[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

# Tooling written in this repository, not copied into a project: PEP 8 for Python, and YAML, which
# cannot be indented with tabs at all.
[*.py]
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_style = space
indent_size = 2
