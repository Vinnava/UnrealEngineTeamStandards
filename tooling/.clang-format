# Team clang-format - standard section 3.10. Copy to the project root.
# Epic style: tabs, braces on their own line. Includes are never reordered, so .generated.h stays last (3.4).
BasedOnStyle: LLVM
Language: Cpp
Standard: Latest

# ForContinuationAndIndentation, not ForIndentation: a wrapped line is indented with a tab like any
# other. With ForIndentation, clang-format indents continuations with spaces and the file ends up
# mixing both, against 3.10 and .editorconfig.
UseTab: ForContinuationAndIndentation
IndentWidth: 4
TabWidth: 4
ContinuationIndentWidth: 4
ColumnLimit: 120

BreakBeforeBraces: Allman
AccessModifierOffset: -4
IndentCaseLabels: true
NamespaceIndentation: All
FixNamespaceComments: true

# LLVM aligns a wrapped argument under the open parenthesis, which it can only do with spaces - the
# same tab/space mix again, and it wastes most of the 120 columns on deep calls. One tab instead.
AlignAfterOpenBracket: DontAlign

# LLVM's C++11 braced-list style strips the inner spaces: { TEXT("World"), TEXT("L_") } becomes
# {TEXT("World"), TEXT("L_")}, and indents the rows with spaces. Off, for Epic's spacing.
Cpp11BracedListStyle: false

# Leave trailing comments where they were written, so the aligned access-specifier block in 3.1
# (private:   // Variables) survives the formatter.
AlignTrailingComments:
  Kind: Leave
  OverEmptyLines: 0

PointerAlignment: Left
DerivePointerAlignment: false

AllowShortFunctionsOnASingleLine: None
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortBlocksOnASingleLine: Never
AllowShortLambdasOnASingleLine: Empty

BreakConstructorInitializers: BeforeComma
AlwaysBreakTemplateDeclarations: Yes
SpaceBeforeParens: ControlStatements
SpacesBeforeTrailingComments: 1

SortIncludes: Never
IncludeBlocks: Preserve

# Two-line comments are written deliberately (5.2); never rewrap them
ReflowComments: false

# Reflection macros have no trailing semicolon; treat them as statements so the next line is not glued on
StatementMacros:
  - GENERATED_BODY
  - GENERATED_UCLASS_BODY
  - GENERATED_USTRUCT_BODY
  - UCLASS
  - USTRUCT
  - UENUM
  - UINTERFACE
  - UPROPERTY
  - UFUNCTION
